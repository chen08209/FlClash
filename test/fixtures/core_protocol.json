{
  "methodCall": {
    "id": "config.update#contract",
    "method": "config.update",
    "arguments": {
      "mixed-port": 7890,
      "allow-lan": true,
      "ipv6": false,
      "geo-auto-update": true,
      "geo-update-interval": 24
    }
  },
  "eventCall": {
    "method": "message",
    "arguments": [
      {
        "type": "loaded",
        "data": "provider-a"
      },
      {
        "type": "delay",
        "data": {
          "name": "proxy-a",
          "url": "https://example.com",
          "value": 42
        }
      }
    ]
  },
  "successResponse": {
    "id": "config.update#contract",
    "result": null
  },
  "structuredResponse": {
    "id": "traffic.current#contract",
    "result": {
      "up": 12,
      "down": 34
    }
  },
  "spilledResponse": {
    "id": "config.read#spilled",
    "result": null,
    "file": "/home/responses/1234.json"
  },
  "errorResponse": {
    "id": "config.read#contract",
    "result": null,
    "error": {
      "code": "core_error",
      "message": "config not found",
      "details": null
    }
  }
}
